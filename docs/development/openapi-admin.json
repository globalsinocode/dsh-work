        },
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminActionPlanConfirmation" } } }
        }
      }
    },
    "/assistant/action-plans/{id}/cancel": {
      "post": {
        "operationId": "cancelAdminAssistantActionPlan",
        "summary": "取消尚未执行的专用助手操作计划",
        "responses": {
          "200": { "$ref": "#/components/responses/Ok" },
          "403": { "description": "没有管理写权限或不拥有此对话" }
        },
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ]
      }
    },
    "/assistant/runs/{id}/confirm": {
      "post": {
