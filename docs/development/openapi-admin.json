          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "description": "没有管理权限或不拥有此对话"
          },
          "503": {
            "description": "未配置数据库或 DSH 安装助手不可用"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/assistant/runs/{id}/retry": {
      "post": {
        "operationId": "retryAdminAssistantRun",
        "summary": "失败或取消后新增 Attempt，沿用同一 Run",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "description": "没有管理权限或不拥有此对话"
          },
          "503": {
            "description": "未配置数据库或 DSH 安装助手不可用"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "adminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "dsh_work_admin_session",
        "description": "AI Hub OIDC 回调后由 dsh-work 设置的不透明 HttpOnly Session Cookie；生产名称使用 __Host- 前缀。"
      }
    },
    "parameters": {
      "AgentId": {
        "name": "agentId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "RunId": {
        "name": "runId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "UserId": {
        "name": "userId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "RoleId": {
        "name": "roleId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "requestBodies": {
      "Agent": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AgentInput"
            }
          }
        }
      }
    },
    "responses": {
      "Ok": {
        "description": "成功",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Envelope"
            }
          }
        }
      },
      "Error": {
        "description": "失败",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "AgentConfiguration": {
        "type": "object",
        "required": [
          "name",
          "description",
          "owner",
          "department",
          "visibility",
          "welcomeMessage",
          "examplePrompts",
          "roleIds",
          "dataScopes",
          "systemPrompt",
          "maxTokens",
          "timeoutSeconds",
          "skills",
          "tools",
          "changeSummary"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "owner": {
            "type": "string",
            "description": "兼容字段；服务端以创建人或既有负责人为准"
          },
          "department": {
            "type": "string",
            "description": "兼容字段；服务端以负责人部门为准"
          },
          "visibility": {
            "type": "string",
            "description": "展示摘要；授权以 roleIds 为准"
          },
          "welcomeMessage": {
            "type": "string",
            "maxLength": 500
          },
          "examplePrompts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "systemPrompt": {
            "type": "string",
            "minLength": 20,
            "maxLength": 20000
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Skill 标识@版本"
            },
            "uniqueItems": true
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "工具标识@版本"
            },
            "uniqueItems": true
          },
          "roleIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "dataScopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "maxTokens": {
            "type": "integer",
            "minimum": 1
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "changeSummary": {
            "type": "string"
          }
        }
      },
      "CreateAgentInput": {
        "unevaluatedProperties": false,
        "allOf": [
          {
            "$ref": "#/components/schemas/AgentConfiguration"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{2,47}$"
              }
            }
          }
        ]
      },
      "UpdateAgentInput": {
        "unevaluatedProperties": false,
        "allOf": [
          {
            "$ref": "#/components/schemas/AgentConfiguration"
          },
          {
            "type": "object",
            "required": [
              "agentId"
            ],
            "properties": {
              "agentId": {
                "type": "string"
              }
            }
          }
        ]
      },
      "SetAgentWorkspaceJoinInput": {
        "type": "object",
        "unevaluatedProperties": false,
        "required": [
          "allowWorkspaceJoin"
        ],
        "properties": {
          "allowWorkspaceJoin": {
            "type": "boolean",
            "description": "true 允许加入团队空间（默认）；false 后不再出现在团队空间「添加 Agent」候选，也不能被加入"
          }
        }
      },
      "ReconcileGrantSourcesInput": {
        "type": "object",
        "unevaluatedProperties": false,
        "required": [
          "sourceIds"
        ],
        "properties": {
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "description": "workspace_grant_sources.id；必须是 active 的 legacy_unresolved 来源"
            }
          }
        }
      },
      "SkillConfiguration": {
        "type": "object",
        "required": [
          "name",
          "category",
          "description",
          "instructions",
          "toolIds",
          "testPrompt"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200
          },
          "instructions": {
            "type": "string",
            "minLength": 20,
            "maxLength": 10000
          },
          "toolIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "testPrompt": {
            "type": "string",
            "minLength": 4,
            "maxLength": 500
          }
        }
      },
      "CreateSkillInput": {
        "unevaluatedProperties": false,
        "allOf": [
          {
            "$ref": "#/components/schemas/SkillConfiguration"
          }
        ]
      },
      "UpdateSkillInput": {
        "unevaluatedProperties": false,
        "allOf": [
          {
            "$ref": "#/components/schemas/SkillConfiguration"
          },
          {
            "type": "object",
            "required": [
              "skillId"
            ],
            "properties": {
              "skillId": {
                "type": "string"
              }
            }
          }
        ]
      },
      "Envelope": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {},
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "object",
              "suggestion",
              "traceId"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "object": {
                "type": "string"
              },
              "suggestion": {
                "type": "string"
              },
              "traceId": {
                "type": "string"
              }
            }
          }
        }
      },
      "Meta": {
        "type": "object",
        "required": [
          "requestId",
          "timestamp"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AssistantMessageInput": {
        "type": "object",
        "required": [
          "sessionId",
          "message",
          "requestId"
        ],
        "additionalProperties": false,
        "properties": {
          "sessionId": {
            "type": "string",
            "pattern": "^admin-session-[a-f0-9-]{36}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "requestId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 80
          }
        }
      },
      "AdminTaskProposalConfirmation": {
        "type": "object",
        "required": ["proposalSha256"],
        "additionalProperties": false,
        "properties": {
          "proposalSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "管理员确认的专用助手调用提案摘要。"
          }
        }
      },
      "AdminActionPlanConfirmation": {
        "type": "object",
        "required": ["planSha256"],
        "additionalProperties": false,
        "properties": {
          "planSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "管理员确认的 Agent 或 Runtime 精确变更计划摘要。"
          }
        }
      },
      "SkillInstallationConfirmation": {
        "type": "object",
        "required": [
          "planSha256"
        ],
        "additionalProperties": false,
        "properties": {
          "planSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "管理员确认的完整安装计划摘要，不是单个 Skill 包摘要。"
          }
        }
      },
      "AdminAssistantConversation": {
        "type": "object",
        "required": [
          "id",
          "title",
          "messages",
          "runs",
          "installations",
          "proposals",
          "actions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "role",
                "text",
                "runId"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "runId": {
                  "type": "string"
                }
              }
            }
          },
          "runs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "queued",
                    "running",
                    "cancel_requested",
                    "succeeded",
                    "failed",
                    "cancelled"
                  ]
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "installations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "runId": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "resolvedUrl": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "resolvedRef": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "enum": [
                    "pending",
                    "installed",
                    "cancelled"
                  ]
                },
                "skillId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "package": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "description": "根 Skill 的安全预览，不传资源正文。"
                },
                "plan": {
                  "type": [
                    "object",
