            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SkillInstallationConfirmation"
              }
            }
          }
        }
      }
    },
    "/assistant/runs/{id}/cancel": {
      "post": {
        "operationId": "cancelSkillInstallation",
