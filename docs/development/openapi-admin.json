{
  "openapi": "3.1.0",
  "info": {
    "title": "dsh-work 管理平台 API",
    "version": "0.7.1-identity-owned-authorization",
    "description": "管理面请求使用 AI Hub OIDC 登录后由 dsh-work 签发的 HttpOnly 服务端 Session。AI Hub 只提供身份和员工资料；admin:read、admin:write、audit:read、角色与数据范围全部由 dsh-work 本地授权。身份同步、角色、员工授权和 Session 撤销仅允许本地平台管理员（admin:*）修改。操作人由服务端 Session 注入，请求体不接受 actor。"
  },
  "servers": [
    {
      "url": "/api/admin/v1"
    }
  ],
  "security": [
    {
      "adminSession": []
    }
  ],
  "paths": {
    "/session": {
      "get": {
        "operationId": "getAdminSession",
        "summary": "获取管理员身份、角色和权限",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/agents": {
      "get": {
        "operationId": "listAgents",
        "summary": "查询 Agent",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      },
      "post": {
        "operationId": "createAgent",
        "summary": "创建 Agent；创建者自动成为负责人",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAgentInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/Ok"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/agents/draft": {
      "patch": {
        "operationId": "updateAgentDraft",
        "summary": "更新草稿；编辑已发布 Agent 时创建下一版本草稿",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAgentInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/agents/test": {
      "post": {
        "operationId": "testAgent",
        "summary": "校验当前 Agent 草稿并持久化测试证据",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/agents/status": {
      "patch": {
        "operationId": "setAgentStatus",
        "summary": "发布、启用或停用 Agent；发布要求当前配置测试通过",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/agents/rollback": {
      "post": {
        "operationId": "rollbackAgent",
        "summary": "将活动版本指针回滚到指定已发布版本",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/agents/{agentId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/AgentId"
        }
      ],
      "patch": {
        "operationId": "setAgentWorkspaceJoin",
        "summary": "平台治理开关：允许或禁止该 Agent 加入团队空间；关闭后不再出现在团队空间「添加 Agent」候选",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetAgentWorkspaceJoinInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/agents/{agentId}/workspaces": {
      "parameters": [
        {
          "$ref": "#/components/parameters/AgentId"
        }
      ],
      "get": {
        "operationId": "listAgentJoinedWorkspaces",
        "summary": "查询该 Agent 只读的「已加入空间」清单，用于评估停用影响",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/agent-versions": {
      "get": {
        "operationId": "listAgentVersions",
        "summary": "查询不可变 Agent 版本历史",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/agent-release-records": {
      "get": {
        "operationId": "listAgentReleaseRecords",
        "summary": "查询 Agent 发布、启停和回滚记录",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/skills": {
      "get": {
        "operationId": "listSkills",
        "summary": "查询 Skill，并返回安装入口角色与当前版本的递归依赖摘要",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      },
      "post": {
        "operationId": "createSkill",
        "summary": "创建 Skill 草稿，标识由系统自动生成",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSkillInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/Ok"
          }
        }
      },
      "patch": {
        "operationId": "updateSkill",
        "summary": "更新草稿；编辑已发布 Skill 时创建下一版本草稿",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSkillInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/skills/test": {
      "post": {
        "operationId": "testSkill",
        "summary": "兼容接口：同步校验当前 Skill 草稿并持久化配置指纹证据",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/skills/test-runs": {
      "post": {
        "operationId": "startSkillTestRun",
        "summary": "启动 Skill 严格试运行并立即返回 Run 标识与初始进度",
        "responses": {
          "202": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/skills/{skillId}/test-runs/{runId}": {
      "get": {
        "operationId": "getSkillTestRun",
        "summary": "读取 Skill 严格试运行的真实 Run、激活与脚本执行进度",
        "parameters": [
          { "name": "skillId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "runId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/skills/status": {
      "patch": {
        "operationId": "setSkillStatus",
        "summary": "发布、启用或停用 Skill；发布要求当前配置测试通过",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/skills/rollback": {
      "post": {
        "operationId": "rollbackSkill",
        "summary": "将活动版本指针回滚到指定已发布 Skill Version",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/skill-versions": {
      "get": {
        "operationId": "listSkillVersions",
        "summary": "查询不可变 Skill 版本历史",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/skill-release-records": {
      "get": {
        "operationId": "listSkillReleaseRecords",
        "summary": "查询 Skill 发布、启停和回滚记录",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/tools": {
      "get": {
        "operationId": "listTools",
        "summary": "查询已添加的平台工具",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      },
      "post": {
        "operationId": "addTool",
        "summary": "从当前 DSH Profile 的已加载工具中添加平台支持项并配置初始权限",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/tools/catalog": {
      "get": {
        "operationId": "listToolCatalog",
        "summary": "查询当前 DSH Profile 已加载工具及其平台安装和兼容状态",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/tools/status": {
      "patch": {
        "operationId": "setToolStatus",
        "summary": "启用或停用平台预置 Tool；连接器异常时禁止启用",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/tools/permissions": {
      "patch": {
        "operationId": "updateToolPermissions",
        "summary": "更新 Tool 授权角色、数据范围和审批策略",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/connectors": {
      "get": {
        "operationId": "listConnectors",
        "summary": "查询平台预置连接器；一期只读",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/connectors/check": {
      "post": {
        "operationId": "checkConnector",
        "summary": "执行连接器健康检查并联动 Tool 可用状态",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/runtimes": {
      "get": {
        "operationId": "listRuntimes",
        "summary": "查询 Runtime 实例和健康状态",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/runtimes/check": {
      "post": {
        "operationId": "checkRuntime",
        "summary": "执行真实 Runtime Adapter 健康检查并回写心跳和版本",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/runtimes/configuration": {
      "get": {
        "operationId": "getRuntimeConfiguration",
        "summary": "获取当前 Runtime 调度策略和配置版本",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      },
      "patch": {
        "operationId": "updateRuntimeConfiguration",
        "summary": "更新并发、Attempt 超时与接收任务/排空/停用状态",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/sessions": {
      "get": {
        "operationId": "listSessions",
        "summary": "按治理条件查询 Session 摘要，不建设独立全量消息浏览器",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/workspaces": {
      "get": {
        "operationId": "listWorkspaces",
        "summary": "查询团队工作空间",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/grant-sources/unresolved": {
      "get": {
        "operationId": "listUnresolvedGrantSources",
        "summary": "授权来源对账清单：列出 legacy_unresolved 来源及按 agent_versions 推断的可能归属 Agent（仅提示不自动回填）",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/grant-sources/reconcile": {
      "post": {
        "operationId": "reconcileGrantSources",
        "summary": "对账完成：把 legacy_unresolved 来源改写为 manual 并记审计；撤销行保留不物理删除",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReconcileGrantSourcesInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/model-usage": {
      "get": {
        "operationId": "getModelUsage",
        "summary": "查询包含员工归属的 Token 和延迟明细",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/model-providers": {
      "get": {
        "operationId": "listModelProviders",
        "summary": "查询 Provider、模型和密钥引用状态，不返回密钥正文",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      },
      "post": {
        "operationId": "createModelProvider",
        "summary": "创建平台级模型 Provider",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/model-providers/status": {
      "patch": {
        "operationId": "setModelProviderStatus",
        "summary": "启用或停用 Provider",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/model-providers/credential-reference": {
      "patch": {
        "operationId": "updateModelCredentialReference",
        "summary": "登记外部密钥引用和状态；请求不得包含密钥正文",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/provider-models": {
      "post": {
        "operationId": "createProviderModel",
        "summary": "向 Provider 注册可治理模型",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/model-routes": {
      "get": {
        "operationId": "listModelRoutes",
        "summary": "查询平台模型路由",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      },
      "post": {
        "operationId": "createModelRoute",
        "summary": "创建平台模型路由；Agent 不配置模型策略",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/model-routes/resolve": {
      "post": {
        "operationId": "resolveModelRoute",
        "summary": "诊断路由解析并返回不含密钥的快照",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/audit-events": {
      "get": {
        "operationId": "listOperationalEvents",
        "summary": "查询管理、安全、运行、模型、工具和成果的脱敏统一事件",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/operations/summary": {
      "get": {
        "operationId": "getOperationsSummary",
        "summary": "查询近 24 小时运行、Token、工具、成果与需关注事件汇总",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/operations/runs/{runId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "get": {
        "operationId": "getRunOperations",
        "summary": "按 Run 下钻运行、模型、工具和成果安全时间线",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/identity/users": {
      "get": {
        "operationId": "listIdentityUsers",
        "summary": "分页查询从 AI Hub 同步的员工及其本地角色、数据范围和 Session 摘要",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "disabled"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 10,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/identity/users/{userId}/roles": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UserId"
        }
      ],
      "post": {
        "operationId": "grantIdentityUserRole",
        "summary": "由平台管理员为员工分配 dsh-work 本地角色",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/identity/users/{userId}/roles/{roleId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UserId"
        },
        {
          "$ref": "#/components/parameters/RoleId"
        }
      ],
      "delete": {
        "operationId": "revokeIdentityUserRole",
        "summary": "由平台管理员移除员工的本地角色；禁止移除最后一个平台管理员",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/identity/users/{userId}/scopes": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UserId"
        }
      ],
      "patch": {
        "operationId": "replaceIdentityUserScopes",
        "summary": "由平台管理员替换员工在 dsh-work 中的直接数据范围",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/identity/users/{userId}/sessions/revoke": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UserId"
        }
      ],
      "post": {
        "operationId": "revokeIdentityUserSessions",
        "summary": "由平台管理员撤销员工全部 dsh-work 登录 Session",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/identity/roles": {
      "get": {
        "operationId": "listIdentityRoles",
        "summary": "查询 dsh-work 本地角色、权限和数据范围",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      },
      "post": {
        "operationId": "createIdentityRole",
        "summary": "由平台管理员创建 dsh-work 本地角色",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/identity/roles/{roleId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RoleId"
        }
      ],
      "patch": {
        "operationId": "updateIdentityRole",
        "summary": "由平台管理员更新本地角色的状态、权限和数据范围",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
