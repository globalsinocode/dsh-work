              },
              "entry": {
                "type": "string"
              }
            }
          }
        },
        "assertions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "reply_contains"
                  },
                  "value": {
