{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-work.local/schemas/runtime-manifest.schema.json",
  "title": "dsh-work Runtime Manifest",
  "description": "控制面下发给 DSH Runtime Adapter 的一次不可变执行快照。",
  "type": "object",
  "required": [
    "manifest_version",
    "run_id",
    "attempt_id",
    "session_id",
    "workspace_id",
    "agent_version_id",
    "agent_configuration",
    "user_context",
    "permission_policy",
    "skills",
    "tools",
    "data_scopes",
    "knowledge_context",
    "input",
    "limits",
    "created_at"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "description": "员工运行必须归属工作空间；admin purpose 使用空字符串且不绑定员工 Agent。"
    },
    "agent_version_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "直接使用平台默认助手时可为 null。"
    },
    "agent_configuration": {
      "type": "object",
      "required": [
        "system_prompt",
        "skill_instructions"
      ],
      "properties": {
        "system_prompt": {
          "type": "string",
          "minLength": 20,
          "description": "当前 Agent Version 锁定的 System Prompt。"
        },
        "skill_instructions": {
          "type": "array",
          "description": "Agent 引用的已发布 Skill Version 固定快照。新 Run 只向 DSH 展示 name/description 目录，完整 instructions 由 activate_skill 按需返回。Skill 为内联（携带 instructions 正文）或外置（artifact_ref + instructions_sha256 + files 索引）二选一，不兼容外置引用携带内联正文缓存。",
          "items": {
            "type": "object",
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string",
                "maxLength": 80
              },
              "description": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "instructions": {
                "type": "string",
                "minLength": 20,
                "description": "内联 Skill 的正文；外置 Skill 不提供此字段。"
              },
              "artifact_ref": {
                "type": "string",
                "pattern": "^packages/(?:[A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9._-]{0,62}[A-Za-z0-9])/[a-f0-9]{64}$",
                "description": "外置 Skill 的内容存储引用；必须与 instructions_sha256、files 索引同时出现。包名段首尾必须为字母数字：Schema、编译器与存储层读写同口径，旧版生成器未清理首尾符号的引用不再接受。"
              },
              "instructions_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "description": "外置 Skill 说明正文的内容摘要；摘要真实性由编译/加载阶段读取内容后校验。"
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "disable_model_invocation": {
                "type": "boolean"
              },
              "files": {
                "type": "array",
                "maxItems": 64,
                "description": "外置 Skill 为内容索引（不得携带 content）且必须含 SKILL.md 条目；内联 Skill 的文件必须携带 content。",
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "sha256",
                    "size"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "required": [
                    "artifact_ref"
                  ],
                  "properties": {
                    "artifact_ref": {
                      "type": "string"
                    }
                  }
                },
                "then": {
                  "required": [
                    "instructions_sha256",
                    "files"
                  ],
                  "properties": {
                    "instructions": false,
                    "instructions_sha256": {
                      "type": "string"
                    },
                    "files": {
                      "type": "array",
                      "minItems": 1,
                      "contains": {
                        "type": "object",
                        "required": [
                          "path"
                        ],
                        "properties": {
                          "path": {
                            "const": "SKILL.md"
                          }
                        }
                      },
                      "items": {
                        "type": "object",
                        "properties": {
                          "content": false
                        }
                      }
                    }
                  }
                },
                "else": {
                  "required": [
                    "instructions"
                  ],
                  "properties": {
                    "instructions": {
                      "type": "string"
                    },
                    "instructions_sha256": false,
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "content"
                        ],
                        "properties": {
                          "content": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "user_context": {
      "type": "object",
      "required": [
        "user_id",
        "tenant_id",
        "role_ids"
      ],
      "properties": {
        "user_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "role_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "permission_policy": {
      "type": "object",
      "required": [
        "approval_mode",
        "network_policy",
        "write_policy"
      ],
      "properties": {
        "approval_mode": {
          "enum": [
            "always",
            "risk_based",
            "never"
          ],
          "description": "always 与 risk_based 进入服务端确认策略；never 表示工具已通过角色、范围和 Allowlist 校验后无需额外审批。"
        },
        "network_policy": {
          "enum": [
            "deny",
            "allowlist"
          ]
        },
        "write_policy": {
          "enum": [
            "deny",
            "workspace_only",
            "approved_targets"
          ]
        }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capabilityRef"
      },
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capabilityRef"
      },
      "uniqueItems": true
    },
    "data_scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "knowledge_context": {
      "type": "array",
      "maxItems": 3,
      "description": "控制面按用户、角色和工作空间过滤后固化的版本化知识片段。",
      "items": {
        "type": "object",
        "required": [
          "documentId",
          "title",
          "version",
          "effectiveDate",
          "dataScope",
          "contentChecksum",
          "excerpt"
        ],
        "properties": {
          "documentId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "effectiveDate": {
            "type": "string",
            "format": "date"
          },
          "dataScope": {
            "type": "string"
          },
          "contentChecksum": {
            "type": "string",
            "pattern": "^[a-f0-9]{32,64}$"
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "additionalProperties": false
      }
    },
    "model_route_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "由平台模型网关按企业策略选择，不属于 Agent 创建表单。"
    },
    "input": {
      "type": "object",
      "required": [
        "message",
        "file_mounts"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "file_mounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileMount"
          }
        },
        "conversation_history": {
          "type": "array",
          "maxItems": 12,
          "description": "同一授权会话的最近消息，内容合计最多 24000 字符；历史不构成新操作授权。",
          "items": {
            "type": "object",
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string",
                "maxLength": 24000
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "timeout_seconds",
        "max_output_bytes",
        "max_tool_calls"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "admin-assistant",
        "admin-skill-install",
        "admin-skill-test",
        "admin-agent-manage",
        "admin-platform-operations",
        "agent-release-trial",
        "automation"
      ],
      "description": "管理侧 purpose（admin-* 与 agent-release-trial）的运行不绑定员工 Workspace/Agent；automation 是员工侧定时任务运行，仍要求 workspace_id 与 agent_version_id。"
    },
    "installation_source": {
      "type": "string",
      "maxLength": 20000,
      "description": "平台确定性解析后的已有来源 JSON；不是模型可覆盖的参数。"
    },
    "test_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requiredSkills",
        "requiredPythonEntries",
        "assertions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "requiredSkills": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string"
          }
        },
        "requiredPythonEntries": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skill",
              "entry"
            ],
            "properties": {
              "skill": {
                "type": "string"
              },
              "entry": {
                "type": "string"
              }
            }
          }
        },
        "assertions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "reply_contains"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "path",
                  "expected"
                ],
                "properties": {
                  "kind": {
                    "const": "reply_json_equals"
                  },
                  "path": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,64}$"
                    }
                  },
                  "expected": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "capabilityRef": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "fileMount": {
      "type": "object",
      "required": [
        "file_id",
        "mount_path",
        "access",
        "source_name",
        "media_type",
        "content_sha256",
        "content"
      ],
      "properties": {
        "file_id": {
          "type": "string"
        },
        "mount_path": {
          "type": "string",
          "pattern": "^/workspace/input/[A-Za-z0-9._-]+\\.txt$"
        },
        "access": {
          "const": "read_only"
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "purpose"
        ],
        "properties": {
          "purpose": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^admin-"
              },
              {
                "const": "agent-release-trial"
              }
            ]
          }
        }
      },
      "then": {
        "properties": {
          "workspace_id": {
            "const": ""
          },
          "agent_version_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "workspace_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "test_scenario"
        ],
        "properties": {
          "test_scenario": {
            "type": "object"
          }
        }
      },
      "then": {
        "required": [
          "purpose"
        ],
        "properties": {
          "purpose": {
            "const": "admin-skill-test"
          }
        }
      }
    }
  ]
}
