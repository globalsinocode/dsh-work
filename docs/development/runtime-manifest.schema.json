  "$defs": {
    "capabilityRef": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "toolBindingRef": {
      "type": "object",
      "required": [
        "tool",
        "binding_id",
        "revision",
        "digest"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]+@[A-Za-z0-9._:-]+$"
        },
        "binding_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "绑定修订的语义摘要；修订行不可变保存完整快照（连接/凭据槽位/身份策略/环境/授权范围），Attempt 凭此引用追溯。"
        }
      },
      "additionalProperties": false
    },
    "mcpConnectionRef": {
      "type": "object",
      "required": [
        "connector_id",
        "server_name",
        "transport",
        "endpoint",
        "auth_type",
        "capability_digest"
      ],
      "properties": {
        "connector_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "server_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        },
        "transport": {
          "const": "streamable-http"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^https?://"
        },
        "auth_type": {
          "enum": ["none", "bearer"]
        },
        "capability_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "fileMount": {
      "type": "object",
      "required": [
        "file_id",
        "mount_path",
        "access",
        "source_name",
        "media_type",
        "content_sha256",
        "content"
      ],
      "properties": {
        "file_id": {
          "type": "string"
        },
        "mount_path": {
          "type": "string",
          "pattern": "^/workspace/input/[A-Za-z0-9._-]+\\.txt$"
        },
        "access": {
          "const": "read_only"
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512000
        },
        "artifact_revision": {
          "type": "object",
          "required": [
            "artifact_id",
            "version"
          ],
          "additionalProperties": false,
          "description": "EX-02：挂载内容是该成果版本的原文；向 output/<source_name> 写入同名文件会登记为下一版本",
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^artifact-[A-Za-z0-9-]+$"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
