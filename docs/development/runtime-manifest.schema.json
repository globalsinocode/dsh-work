{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-work.local/schemas/runtime-manifest.schema.json",
  "title": "dsh-work Runtime Manifest",
  "description": "控制面下发给 DSH Runtime Adapter 的一次不可变执行快照。",
  "type": "object",
  "required": [
    "manifest_version",
    "run_id",
    "attempt_id",
    "task_id",
    "session_id",
    "workspace_id",
    "agent_version_id",
    "agent_configuration",
    "user_context",
    "permission_policy",
    "skills",
    "tools",
    "data_scopes",
    "knowledge_context",
    "input",
    "budget",
    "limits",
    "created_at"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "稳定业务 Task 标识；Session 仅是可选交互上下文。"
    },
    "session_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "产品对话上下文；API、事件和系统触发可为 null。"
    },
    "workspace_id": {
      "type": "string",
      "description": "员工运行必须归属工作空间；admin purpose 使用空字符串且不绑定员工 Agent。"
    },
    "agent_version_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "直接使用平台默认助手时可为 null。"
    },
    "agent_configuration": {
      "type": "object",
      "required": [
        "system_prompt",
        "skill_instructions"
      ],
      "properties": {
        "system_prompt": {
          "type": "string",
          "minLength": 20,
          "description": "当前 Agent Version 锁定的 System Prompt。"
        },
        "skill_instructions": {
          "type": "array",
          "description": "Agent 引用的已发布 Skill Version 固定快照。新 Run 只向 DSH 展示 name/description 目录，完整 instructions 由 activate_skill 按需返回。Skill 为内联（携带 instructions 正文）或外置（artifact_ref + instructions_sha256 + files 索引）二选一，不兼容外置引用携带内联正文缓存。",
          "items": {
            "type": "object",
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string",
                "maxLength": 80
              },
              "description": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "instructions": {
                "type": "string",
                "minLength": 20,
                "description": "内联 Skill 的正文；外置 Skill 不提供此字段。"
              },
              "artifact_ref": {
                "type": "string",
                "pattern": "^packages/(?:[A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9._-]{0,62}[A-Za-z0-9])/[a-f0-9]{64}$",
                "description": "外置 Skill 的内容存储引用；必须与 instructions_sha256、files 索引同时出现。包名段首尾必须为字母数字：Schema、编译器与存储层读写同口径，旧版生成器未清理首尾符号的引用不再接受。"
              },
              "instructions_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "description": "外置 Skill 说明正文的内容摘要；摘要真实性由编译/加载阶段读取内容后校验。"
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "disable_model_invocation": {
                "type": "boolean"
              },
              "files": {
                "type": "array",
                "maxItems": 64,
                "description": "外置 Skill 为内容索引（不得携带 content）且必须含 SKILL.md 条目；内联 Skill 的文件必须携带 content。",
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "sha256",
                    "size"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "required": [
                    "artifact_ref"
                  ],
                  "properties": {
                    "artifact_ref": {
                      "type": "string"
                    }
                  }
                },
                "then": {
                  "required": [
                    "instructions_sha256",
                    "files"
                  ],
                  "properties": {
                    "instructions": false,
                    "instructions_sha256": {
                      "type": "string"
                    },
                    "files": {
                      "type": "array",
                      "minItems": 1,
                      "contains": {
                        "type": "object",
                        "required": [
                          "path"
                        ],
                        "properties": {
                          "path": {
                            "const": "SKILL.md"
                          }
                        }
                      },
                      "items": {
                        "type": "object",
                        "properties": {
                          "content": false
                        }
                      }
                    }
                  }
                },
                "else": {
                  "required": [
                    "instructions"
                  ],
                  "properties": {
                    "instructions": {
                      "type": "string"
                    },
                    "instructions_sha256": false,
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "content"
                        ],
                        "properties": {
                          "content": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "user_context": {
      "type": "object",
      "required": [
        "user_id",
        "tenant_id",
        "role_ids"
      ],
      "properties": {
        "user_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "role_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "principal_context": {
      "type": "object",
      "required": ["initiated_by", "executed_as", "disclosure_user_id", "executor_authorization_version"],
      "properties": {
        "initiated_by": { "type": "string", "minLength": 1 },
        "executed_as": { "type": "string", "minLength": 1 },
        "disclosure_user_id": { "type": "string", "minLength": 1 },
        "executor_authorization_version": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "permission_policy": {
      "type": "object",
      "required": [
        "approval_mode",
        "network_policy",
        "write_policy"
      ],
      "properties": {
        "approval_mode": {
          "enum": [
            "always",
            "risk_based",
            "never"
          ],
          "description": "always 与 risk_based 进入服务端确认策略；never 表示工具已通过角色、范围和 Allowlist 校验后无需额外审批。"
        },
        "network_policy": {
          "enum": [
            "deny",
            "allowlist"
          ]
        },
        "write_policy": {
          "enum": [
            "deny",
            "workspace_only",
            "approved_targets"
          ]
        }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capabilityRef"
      },
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capabilityRef"
      },
      "uniqueItems": true
    },
    "tool_bindings": {
      "type": "array",
      "description": "B-03/I-04：Attempt 固定的平台工具绑定修订引用（批准的连接/凭据槽位/身份策略/环境/授权范围的语义摘要）。无平台工具的运行省略该字段；引用是执行证据而非继续授权。",
      "items": {
        "$ref": "#/$defs/toolBindingRef"
      }
    },
    "mcp_connections": {
      "type": "array",
      "description": "PF-03：本 Attempt 固定的 MCP Connector 快照。运行时按当前连接器状态和能力摘要持续复核；快照不包含凭据值。",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/mcpConnectionRef"
      }
    },
    "data_scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "knowledge_context": {
      "type": "array",
      "maxItems": 3,
      "description": "控制面按用户、角色和工作空间过滤后固化的版本化知识片段。",
      "items": {
        "type": "object",
        "required": [
          "documentId",
          "title",
          "version",
          "effectiveDate",
          "dataScope",
          "contentChecksum",
          "excerpt"
        ],
        "properties": {
          "documentId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "effectiveDate": {
            "type": "string",
            "format": "date"
          },
          "dataScope": {
            "type": "string"
          },
          "contentChecksum": {
            "type": "string",
            "pattern": "^[a-f0-9]{32,64}$"
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "additionalProperties": false
      }
    },
    "project_context": {
      "type": "object",
      "description": "项目空间 S1/S2：项目任务线程的执行固定当时的项目简报与项目档案版本，至少携带其一；参考资料，不是操作授权。",
      "minProperties": 1,
      "properties": {
        "brief": {
          "type": "object",
          "required": ["version_id", "version_no", "content", "content_sha256", "due_date"],
          "properties": {
            "version_id": { "type": "string", "minLength": 1 },
            "version_no": { "type": "integer", "minimum": 1 },
            "content": { "type": "string", "minLength": 1, "maxLength": 8000 },
            "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "due_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          },
          "additionalProperties": false
        },
        "archive": {
          "type": "object",
          "description": "项目空间 S2：执行时的项目档案版本。条目规范化、去重与摘要一致性由编译器校验。",
          "required": ["version_id", "version_no", "items", "items_sha256"],
          "properties": {
            "version_id": { "type": "string", "minLength": 1 },
            "version_no": { "type": "integer", "minimum": 1 },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 500 }
            },
            "items_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "memory_context": {
      "type": "array",
      "maxItems": 3,
      "description": "PF-05：经来源授权、人工审核及当前 ACL 过滤后，为本 Attempt 固定的非权威偏好或经验版本。",
      "items": {
        "type": "object",
        "required": [
          "memoryVersionId",
          "title",
          "version",
          "kind",
          "visibility",
          "contentDigest",
          "excerpt"
        ],
        "properties": {
          "memoryVersionId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "version": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["preference", "experience"] },
          "visibility": { "enum": ["private", "workspace", "organization"] },
          "contentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "excerpt": { "type": "string", "minLength": 1, "maxLength": 4000 }
        },
        "additionalProperties": false
      }
    },
    "model_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["long-context", "structured-output"] }
    },
    "model_route_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "由平台模型网关按企业策略选择，不属于 Agent 创建表单。"
    },
    "input": {
      "type": "object",
      "required": [
        "message",
        "file_mounts"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "file_mounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileMount"
          }
        },
        "conversation_history": {
          "type": "array",
          "maxItems": 500,
          "description": "同一授权会话的首条用户消息与最近消息（EX-02），内容合计最多 64000 字符；管理会话另限 12 条、24000 字符。历史不构成新操作授权。",
          "items": {
            "type": "object",
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string",
                "maxLength": 64000
              }
            },
            "additionalProperties": false
          }
        },
        "conversation_summary": {
          "type": "object",
          "description": "EX-02：平台经 DSH 生成的较早对话摘要，位于首条消息与最近消息之间；原文优先于摘要，摘要不构成操作授权。",
          "required": [
            "content",
            "covered_message_count",
            "sha256"
          ],
          "properties": {
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "covered_message_count": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy", "checkpoint_id", "checkpoint_digest", "source_attempt_id",
        "approval_id", "action_name", "parameter_digest", "resource_ref",
        "data_version", "approved_by", "approved_at", "checkpoint_context_sha256",
        "checkpoint_context"
      ],
      "properties": {
        "strategy": { "const": "new-attempt-context-v1" },
        "checkpoint_id": { "type": "string", "minLength": 1 },
        "checkpoint_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_attempt_id": { "type": "string", "minLength": 1 },
        "approval_id": { "type": "string", "minLength": 1 },
        "action_name": { "type": "string", "minLength": 1 },
        "parameter_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "resource_ref": { "type": "string", "minLength": 1 },
        "data_version": { "type": "string", "minLength": 1 },
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "checkpoint_context_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "checkpoint_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pending_action", "completed_tool_results", "workspace_files", "assistant_output"],
          "properties": {
            "pending_action": {
              "type": "object",
              "additionalProperties": false,
              "required": ["arguments"],
              "properties": {
                "arguments": { "type": "object" }
              }
            },
            "completed_tool_results": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["call_id", "tool_name", "parameter_digest", "result"],
                "properties": {
                  "call_id": { "type": "string", "minLength": 1 },
                  "tool_name": { "type": "string", "minLength": 1 },
                  "parameter_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "result": {}
                }
              }
            },
            "workspace_files": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "content", "sha256"],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 1024,
                    "pattern": "^output/(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000-\\u001F]+$"
                  },
                  "content": { "type": "string" },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
              }
            },
            "assistant_output": { "type": "string", "maxLength": 65536 }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["scope_task_id", "cumulative_limits", "reservation", "enforcement"],
      "properties": {
        "scope_task_id": { "type": "string", "minLength": 1 },
        "cumulative_limits": {
          "type": "object",
          "required": ["max_duration_ms", "max_tool_calls", "max_output_bytes"],
          "properties": {
            "max_duration_ms": { "type": ["integer", "null"], "minimum": 1000, "maximum": 86400000 },
            "max_tool_calls": { "type": ["integer", "null"], "minimum": 0, "maximum": 100000 },
            "max_output_bytes": { "type": ["integer", "null"], "minimum": 1024, "maximum": 1073741824 }
          },
          "additionalProperties": false
        },
        "reservation": {
          "type": "object",
          "required": ["duration_ms", "tool_calls", "output_bytes"],
          "properties": {
            "duration_ms": { "type": "integer", "minimum": 0 },
            "tool_calls": { "type": "integer", "minimum": 0 },
            "output_bytes": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "enforcement": {
          "type": "object",
          "required": ["duration", "tool_calls", "output_bytes", "tokens", "cost"],
          "properties": {
            "duration": { "const": "hard" },
            "tool_calls": { "const": "hard" },
            "output_bytes": { "const": "hard" },
            "tokens": { "const": "unsupported" },
            "cost": { "const": "unsupported" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "timeout_seconds",
        "max_output_bytes",
        "max_tool_calls"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "IANA timezone the run's current time is expressed in; the Runtime Adapter renders created_at in it for the model."
    },
    "trace_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "admin-assistant",
        "admin-skill-install",
        "admin-skill-test",
        "admin-agent-manage",
        "admin-platform-operations",
        "agent-release-trial",
        "automation",
        "agent-routine",
        "session-summary",
        "project-archive"
      ],
      "description": "管理侧 purpose（admin-* 与 agent-release-trial）的运行不绑定员工 Workspace/Agent；automation 是员工拥有的自动任务，agent-routine 是 Agent Principal 拥有的主动任务，二者均要求 workspace_id 与 agent_version_id；session-summary 是平台为长对话生成摘要的系统运行，不绑定 Agent、不带工具，必须带 summary_target；project-archive 是项目空间 S2 的项目档案员系统运行，不绑定 Agent、不带工具与数据范围，必须带 archive_target。"
    },
    "archive_target": {
      "type": "object",
      "description": "项目空间 S2：project-archive 运行所整理的项目空间与整理批次；仅该 purpose 使用。",
      "required": ["workspace_id", "update_id"],
      "properties": {
        "workspace_id": { "type": "string", "minLength": 1 },
        "update_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "summary_target": {
      "type": "object",
      "description": "EX-02：session-summary 运行所摘要的会话与覆盖到的最后一条消息；仅该 purpose 使用。",
      "required": [
        "session_id",
        "covered_through_message_id"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "covered_through_message_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "installation_source": {
      "type": "string",
      "maxLength": 20000,
      "description": "平台确定性解析后的已有来源 JSON；不是模型可覆盖的参数。"
    },
    "test_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requiredSkills",
        "requiredPythonEntries",
        "assertions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "requiredSkills": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string"
          }
        },
        "requiredPythonEntries": {
