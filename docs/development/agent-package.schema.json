{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-work.ai/schemas/agent-package.json",
  "title": "AgentPackage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "dsh-work.ai/v1"
    },
    "kind": {
      "const": "AgentPackage"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,47}$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructions"
      ],
      "properties": {
        "instructions": {
          "type": "string",
          "pattern": "^prompts/[A-Za-z0-9._-]+\\.md$"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skills": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/capabilityRef"
              }
            },
            "tools": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/capabilityRef"
              }
            }
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "text"
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "text"
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conversationHistory"
          ],
          "properties": {
            "conversationHistory": {
              "const": "recent"
            }
          }
        },
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "welcomeMessage": {
              "type": "string",
              "maxLength": 120
            },
            "examplePrompts": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 30,
              "maximum": 600
            },
            "maxToolCalls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "maxOutputBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 1048576
            }
          }
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cases"
          ],
          "properties": {
            "cases": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+\\.ya?ml$"
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirements"
          ],
          "properties": {
            "requirements": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "long-context",
                  "structured-output"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "capabilityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    }
  }
}
