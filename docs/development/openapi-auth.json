{
  "openapi": "3.1.0",
  "info": {
    "title": "dsh-work 登录 API",
    "version": "1.0.0",
    "description": "正式部署只提供账号密码登录（员工端在钉钉客户端内另可免登），无登录模式选择。无自助注册或公开独立账号 Bootstrap；生产要求 HTTPS。AI Hub 登录已删除（迁移 0129）。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/auth/{audience}/configuration": {
      "parameters": [
        {
          "name": "audience",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "admin",
              "workbench"
            ]
          }
        }
      ],
      "get": {
        "operationId": "getAuthenticationMode",
        "responses": {
          "200": {
            "description": "当前部署认证模式",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "localEnabled"
                  ],
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "local",
                        "prototype"
                      ],
                      "description": "正式部署恒为 local；prototype 只出现在测试专用 P0 冒烟服务"
                    },
                    "localEnabled": {
                      "type": "boolean",
                      "description": "是否提供账号密码登录"
                    },
                    "dingtalk": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "corpId"
                      ],
                      "description": "仅员工端、且部署配置了钉钉企业内部应用时返回：钉钉容器内调用 JSAPI requestAuthCode 所需的企业 corpId（非秘密）。管理端不返回",
                      "properties": {
                        "corpId": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/{audience}/login": {
      "parameters": [
        {
          "name": "audience",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "admin",
              "workbench"
            ]
          }
        }
      ],
      "get": {
        "operationId": "openLocalLogin",
        "parameters": [
          {
            "name": "return_to",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "转到当前入口的本地登录页"
          }
        }
      },
      "post": {
        "operationId": "loginWithPassword",
        "summary": "正式部署始终提供；成功后设置独立 Session Cookie，初始密码进入改密页",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "必须与当前受信入口同源"
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功；登录和退出通过 Set-Cookie 管理 HttpOnly Session",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "location"
                  ],
                  "properties": {
                    "location": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "账号或密码错误，或会话已失效"
          },
          "403": {
            "description": "来源或权限不允许；初始密码未修改时业务 API 返回 password_change_required"
          },
          "421": {
            "description": "请求入口不在允许列表"
          },
          "422": {
            "description": "输入无效"
          },
          "429": {
            "description": "尝试次数或密码派生并发超限"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 254,
                    "description": "手机号或邮箱；兼容既有用户名登录"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "writeOnly": true,
                    "maxLength": 128
                  },
                  "returnTo": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/{audience}/password": {
      "parameters": [
        {
          "name": "audience",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "admin",
              "workbench"
            ]
          }
        }
      ],
      "post": {
        "operationId": "changeLocalPassword",
        "summary": "验证当前 Session 与密码；原子修改密码、撤销旧会话并签发当前门户的新会话",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "必须与当前受信入口同源"
          }
        ],
        "responses": {
          "200": {
            "description": "改密成功；Set-Cookie 设置新的 HttpOnly Session，location 为原同源访问地址，无需再次登录",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "location"
                  ],
                  "properties": {
                    "location": {
                      "type": "string",
                      "format": "uri"
                    },
                    "binding": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "bound",
                            "refused",
                            "password_change_required"
                          ],
                          "description": "bound：已绑定并签发 dingtalk 会话；refused：未绑定，已签发普通密码会话；password_change_required：需先修改初始密码，改密请求带回同一凭证后绑定"
                        },
                        "reason": {
                          "type": "string",
                          "enum": [
                            "dingtalk_account_bound_to_other",
                            "account_has_other_binding",
                            "self_bind_locked",
                            "ticket_invalid"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "账号或密码错误，或会话已失效"
          },
          "403": {
            "description": "来源或权限不允许；初始密码未修改时业务 API 返回 password_change_required；钉钉会话（dingtalk）不能用于修改密码（password_session_required）"
          },
          "421": {
            "description": "请求入口不在允许列表"
          },
          "422": {
            "description": "输入无效"
          },
          "429": {
            "description": "尝试次数或密码派生并发超限"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "currentPassword",
                  "newPassword"
                ],
                "properties": {
                  "currentPassword": {
                    "type": "string",
                    "format": "password",
                    "writeOnly": true
                  },
                  "newPassword": {
                    "type": "string",
                    "format": "password",
                    "writeOnly": true,
                    "minLength": 8,
                    "maxLength": 12
                  },
                  "returnTo": {
                    "type": "string"
                  },
                  "dingtalkBindingToken": {
                    "type": "string",
                    "writeOnly": true,
                    "description": "仅员工端、钉钉内“修改初始密码并绑定”：bind-login 返回 password_change_required 时保留的待绑定凭证。改密成功后在同一事务中绑定；凭证失效时改密照常成功，binding 为 refused/ticket_invalid"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "localAdminSession": []
          },
          {
            "localWorkbenchSession": []
          }
        ]
      }
    },
    "/auth/{audience}/logout": {
      "parameters": [
        {
          "name": "audience",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "admin",
              "workbench"
            ]
          }
        }
      ],
      "post": {
        "operationId": "logoutLocalSession",
        "summary": "撤销当前门户会话并清理 Cookie",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "必须与当前受信入口同源"
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功；登录和退出通过 Set-Cookie 管理 HttpOnly Session",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "location"
                  ],
                  "properties": {
                    "location": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "账号或密码错误，或会话已失效"
          },
          "403": {
            "description": "来源或权限不允许；初始密码未修改时业务 API 返回 password_change_required"
          },
          "421": {
            "description": "请求入口不在允许列表"
          },
          "422": {
            "description": "输入无效"
          },
          "429": {
            "description": "尝试次数或密码派生并发超限"
          }
        },
        "description": "注销对应 audience 的 Cookie；没有有效会话也可清理本机 Cookie。"
      }
    },
    "/auth/{audience}/switch-account": {
      "parameters": [
        {
          "name": "audience",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "admin",
              "workbench"
            ]
          }
        }
      ],
      "get": {
        "operationId": "openLocalAccountSwitch",
        "responses": {
          "302": {
            "description": "转到本地登录页；新登录成功后使用新身份"
          }
        }
      }
    },
    "/auth/workbench/dingtalk/login": {
      "post": {
        "operationId": "dingtalkLogin",
        "tags": [
          "钉钉"
        ],
        "summary": "钉钉容器内免登：一次性授权码换取钉钉 userid；有有效绑定时签发 dingtalk 会话，否则返回待绑定凭证",
        "description": "钉钉接入方案 4.3。授权码由钉钉 JSAPI requestAuthCode 取得，一次性，服务端不缓存、不重放；只能用本企业应用的 access_token 换取，非本企业授权码换取失败。dingtalk 会话有效期默认 12 小时（钉钉集成 › 应用配置），只撤销该账号此前的 dingtalk 会话，与桌面密码会话并存。没有有效绑定时不自动建账号。",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "必须与当前受信入口（DSH_WORK_WORKBENCH_ORIGINS）同源"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "authCode"
                ],
                "properties": {
                  "authCode": {
                    "type": "string",
                    "writeOnly": true,
                    "maxLength": 256
                  },
                  "returnTo": {
                    "type": "string",
                    "description": "只接受同源路径；其他取值回到首页"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "signed_in：Set-Cookie 设置 HttpOnly 员工端会话（dsh_work_local_workbench_session）；binding_required：不设置 Cookie，返回服务端保存、单次有效、约 5 分钟过期的待绑定凭证与钉钉姓名、部门（部门读取失败时为 null）",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "status",
                        "location"
                      ],
                      "properties": {
                        "status": {
                          "const": "signed_in"
                        },
                        "location": {
                          "type": "string",
                          "format": "uri"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "status",
                        "bindingToken",
                        "expiresInSeconds",
                        "dingtalkName",
                        "dingtalkDepartment"
                      ],
                      "properties": {
                        "status": {
                          "const": "binding_required"
                        },
                        "bindingToken": {
                          "type": "string"
                        },
                        "expiresInSeconds": {
                          "type": "integer"
                        },
                        "dingtalkName": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "dingtalkDepartment": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "授权码无效、已使用或不属于本企业（dingtalk_auth_code_invalid）"
          },
          "403": {
            "description": "来源校验失败；或钉钉绑定的账号已停用、需先修改初始密码、没有员工端权限"
          },
          "421": {
            "description": "请求入口不在允许列表（公网 origin 未登记）"
          },
          "422": {
            "description": "输入无效"
          },
          "429": {
            "description": "按账号或钉钉 userid 的尝试次数超限"
          },
          "503": {
            "description": "钉钉应用未配置（dingtalk_not_configured）或暂时无法连接钉钉（dingtalk_unavailable）；不降级为其他登录方式"
          }
        }
      }
    },
    "/auth/workbench/dingtalk/bind-login": {
      "post": {
        "operationId": "dingtalkBindLogin",
        "tags": [
          "钉钉"
        ],
        "summary": "钉钉内首次登录即绑定：账号密码 + 待绑定凭证，同一事务内登录并绑定",
        "description": "钉钉接入方案 4.2 方式一。按密码登录的顺序锁定账号与凭据，校验密码与员工端权限，消费待绑定凭证（重复使用、过期、来源不符返回 409 dingtalk_ticket_invalid，不签发会话），写入绑定（bound_by = self）并签发关联该绑定的 dingtalk 会话。不允许绑定时只签发普通密码会话并在 binding 中说明原因：钉钉账号已绑定其他员工、本账号已有另一个有效钉钉绑定（只凭密码不替换）、管理员锁定了自行绑定。需先修改初始密码时不消费凭证，签发密码会话并跳转改密页，改密请求带回凭证后绑定。",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "必须与当前受信入口（DSH_WORK_WORKBENCH_ORIGINS）同源"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "username",
                  "password",
                  "bindingToken"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "writeOnly": true
                  },
                  "bindingToken": {
                    "type": "string",
                    "writeOnly": true
                  },
                  "returnTo": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功；Set-Cookie 设置员工端会话（bound 时为 dingtalk 来源，其余为 local-password）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "location",
                    "binding"
                  ],
                  "properties": {
                    "location": {
                      "type": "string",
                      "format": "uri"
                    },
                    "binding": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "bound",
                            "refused",
                            "password_change_required"
                          ],
                          "description": "bound：已绑定并签发 dingtalk 会话；refused：未绑定，已签发普通密码会话；password_change_required：需先修改初始密码，改密请求带回同一凭证后绑定"
                        },
                        "reason": {
                          "type": "string",
                          "enum": [
                            "dingtalk_account_bound_to_other",
                            "account_has_other_binding",
                            "self_bind_locked",
                            "ticket_invalid"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "账号或密码错误，或账号已停用"
          },
          "409": {
            "description": "待绑定凭证重复使用、过期或来源不符（dingtalk_ticket_invalid）；请重新在钉钉中打开"
          },
          "403": {
            "description": "来源校验失败；或钉钉绑定的账号已停用、需先修改初始密码、没有员工端权限"
          },
          "421": {
            "description": "请求入口不在允许列表（公网 origin 未登记）"
          },
          "422": {
            "description": "输入无效"
          },
          "429": {
            "description": "按账号或钉钉 userid 的尝试次数超限"
          },
          "503": {
            "description": "钉钉应用未配置（dingtalk_not_configured）或暂时无法连接钉钉（dingtalk_unavailable）；不降级为其他登录方式"
          }
        }
      }
    },
    "/auth/{audience}/client-errors": {
      "parameters": [
        {
          "name": "audience",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "admin",
              "workbench"
            ]
          }
        }
      ],
      "post": {
        "operationId": "reportClientErrors",
        "tags": [
          "错误记录"
        ],
        "summary": "浏览器错误上报（登录前后都可调用）",
        "description": "错误记录方案 6.2（OBS-S1）。请求体 ≤32 KB、每批 ≤20 条，结构严格校验，多余字段整批拒绝（422）；消息与堆栈在服务端脱敏后入库，不保存请求体、页面文字与查询参数。已登录时记员工，未登录不记身份、按来源 IP 更严格限流；超出限额的条目丢弃，仍返回 202。",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "必须与当前受信入口同源；其他网站发起的上报返回 403"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "text/plain": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "app",
                  "reports"
                ],
                "properties": {
                  "app": {
                    "type": "string",
                    "enum": [
                      "workbench",
                      "admin"
                    ],
                    "description": "必须与路径中的 audience 一致"
                  },
                  "reports": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "render",
                            "script",
                            "promise",
                            "api",
                            "notice",
                            "load",
                            "stream"
                          ]
                        },
                        "message": {
                          "type": "string",
                          "maxLength": 2000,
                          "description": "失败提示（notice）不得携带"
                        },
                        "stack": {
                          "type": "string",
                          "maxLength": 16000,
                          "description": "服务端只保留帧位置；失败提示不得携带"
                        },
                        "route": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.:/-]{1,120}$",
                          "description": "前端路由名，不是网址"
                        },
                        "traceId": {
                          "type": "string",
                          "pattern": "^trace-http-[0-9a-fA-F-]{36}$"
                        },
                        "runId": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
                        },
                        "code": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_]{1,80}$",
                          "description": "失败提示必填"
                        },
                        "template": {
                          "type": "string",
                          "maxLength": 40,
