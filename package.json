{
  "name": "dsh-work",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm dev:all",
    "dev:server": "pnpm --filter @dsh-work/server dev",
    "dev:workbench": "pnpm --filter @dsh-work/workbench-web dev",
    "dev:admin": "pnpm --filter @dsh-work/admin-web dev",
    "dev:all": "pnpm --parallel --filter @dsh-work/server --filter @dsh-work/workbench-web --filter @dsh-work/admin-web dev",
    "build": "pnpm --filter './apps/*' --filter @dsh-work/server build",
    "typecheck": "pnpm --filter './apps/*' --filter @dsh-work/server typecheck",
    "test:m1": "pnpm --filter @dsh-work/server test:runtime",
    "test:m2": "pnpm --filter @dsh-work/server test:m2",
    "test:m2:integration": "pnpm --filter @dsh-work/server test:m2:integration",
    "test:m3:integration": "pnpm --filter @dsh-work/server test:m3:integration",
    "test:m4:integration": "pnpm --filter @dsh-work/server test:m4:integration",
    "test:m4:skill:integration": "pnpm --filter @dsh-work/server test:m4:skill:integration",
    "test:m4:tool:integration": "pnpm --filter @dsh-work/server test:m4:tool:integration",
    "test:mcp:integration": "pnpm --filter @dsh-work/server test:mcp:integration",
    "test:pf04:integration": "pnpm --filter @dsh-work/server test:pf04:integration",
    "test:m4:knowledge:integration": "pnpm --filter @dsh-work/server test:m4:knowledge:integration",
    "test:m4:file": "pnpm --filter @dsh-work/server test:m4:file",
    "test:m4:file:integration": "pnpm --filter @dsh-work/server test:m4:file:integration",
    "test:m4:authorization:integration": "pnpm --filter @dsh-work/server test:m4:authorization:integration",
    "test:m4:runtime:integration": "pnpm --filter @dsh-work/server test:m4:runtime:integration",
    "test:m4:audit:integration": "pnpm --filter @dsh-work/server test:m4:audit:integration",
    "test:m4:error": "pnpm --filter @dsh-work/server test:m4:error",
    "test:m4:error:integration": "pnpm --filter @dsh-work/server test:m4:error:integration",
    "test:m5:frontend": "pnpm --filter @dsh-work/workbench-web --filter @dsh-work/admin-web test",
    "test:m5:api": "pnpm --filter @dsh-work/server test:m5:api",
    "test:m5:security": "pnpm --filter @dsh-work/server test:m5:security",
    "test:m5:security:integration": "pnpm --filter @dsh-work/server test:m5:security:integration",
    "test:m5:faults": "pnpm --filter @dsh-work/server test:m5:faults",
    "test:sso": "pnpm --filter @dsh-work/server test:sso",
    "test:sso:integration": "pnpm --filter @dsh-work/server test:sso:integration",
    "test:m5:faults:integration": "pnpm --filter @dsh-work/server test:m5:faults:integration",
    "test:m5:capacity:integration": "pnpm --filter @dsh-work/server test:m5:capacity:integration",
    "test:m5:workspace:integration": "pnpm --filter @dsh-work/server test:m5:workspace:integration",
    "test:m5:members:integration": "pnpm --filter @dsh-work/server test:m5:members:integration",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "node scripts/verify.mjs",
    "probe": "node --env-file-if-exists=.env --experimental-strip-types scripts/runtime/probe.ts",
    "probe:handshake": "pnpm probe -- handshake",
    "probe:model": "pnpm probe -- model",
    "probe:tool": "pnpm probe -- tool",
    "probe:artifact": "pnpm probe -- artifact",
    "probe:cancel": "pnpm probe -- cancel",
    "probe:concurrency": "pnpm probe -- concurrency",
    "test:scripts": "node --experimental-strip-types --test scripts/checks/checks.test.mjs scripts/runtime/probe.test.mjs",
    "ci:check": "pnpm verify && pnpm test:scripts && pnpm check:secrets && pnpm typecheck && pnpm test:m1 && pnpm test:skill-install && pnpm test:agent-package && pnpm test:m2 && pnpm test:m4:file && pnpm test:m4:error && pnpm test:m5:frontend && pnpm test:m5:api && pnpm test:m5:security && pnpm test:m5:faults && pnpm test:m5:revocation && pnpm test:sso && pnpm lint && pnpm build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "validate:ui": "pnpm --filter @dsh-work/admin-web --filter @dsh-work/workbench-web validate:ui",
    "lint": "pnpm check:architecture && pnpm validate:ui && eslint apps packages server scripts --max-warnings=0",
    "test:m5:agent-members:integration": "pnpm --filter @dsh-work/server test:m5:agent-members:integration",
    "test:m4:team-auth:integration": "pnpm --filter @dsh-work/server test:m4:team-auth:integration",
    "test:m5:reconciliation:integration": "pnpm --filter @dsh-work/server test:m5:reconciliation:integration",
    "test:m5:workspace:upgrade:integration": "pnpm --filter @dsh-work/server test:m5:workspace:upgrade:integration",
    "test:m5:revocation:integration": "pnpm --filter @dsh-work/server test:m5:revocation:integration",
    "test:m5:revocation": "pnpm --filter @dsh-work/server test:m5:revocation",
    "test:m5:sessions:integration": "pnpm --filter @dsh-work/server test:m5:sessions:integration",
    "test:m5:shared-files:integration": "pnpm --filter @dsh-work/server test:m5:shared-files:integration",
    "test:m5:file-versions:integration": "pnpm --filter @dsh-work/server test:m5:file-versions:integration",
    "test:m5:lifecycle:integration": "pnpm --filter @dsh-work/server test:m5:lifecycle:integration",
    "test:m5:activity:integration": "pnpm --filter @dsh-work/server test:m5:activity:integration",
    "test:m5:usage:integration": "pnpm --filter @dsh-work/server test:m5:usage:integration",
    "bench:team-workspace-statistics": "node --experimental-strip-types --env-file-if-exists=.env scripts/bench/team-workspace-statistics.ts",
    "test:skill-install": "pnpm --filter @dsh-work/server test:skill-install",
    "test:agent-package": "pnpm --filter @dsh-work/server test:agent-package",
    "test:skill-install:integration": "pnpm --filter @dsh-work/server test:skill-install:integration",
    "test:review:unit": "pnpm --filter @dsh-work/server test:review:unit",
    "test:review:integration": "pnpm --filter @dsh-work/server test:review:integration",
    "test:review:batch02:integration": "pnpm --filter @dsh-work/server test:review:batch02:integration",
    "test:review:batch02:unit": "pnpm --filter @dsh-work/server test:review:batch02:unit",
    "test:review:8b:unit": "pnpm --filter @dsh-work/server test:review:8b:unit",
    "test:review:8b:integration": "pnpm --filter @dsh-work/server test:review:8b:integration",
    "test:review:batch03:integration": "pnpm --filter @dsh-work/server test:review:batch03:integration",
    "test:e2e:personal": "playwright test --config playwright.personal.config.ts",
    "test:e2e:automation": "playwright test --config playwright.automation.config.ts",
    "test:e2e:mcp-admin": "playwright test --config playwright.mcp-admin.config.ts",
    "test:review:c6:unit": "pnpm --filter @dsh-work/server test:review:c6:unit",
    "test:review:c6:integration": "pnpm --filter @dsh-work/server test:review:c6:integration",
    "test:review:c7:unit": "pnpm --filter @dsh-work/server test:review:c7:unit",
    "test:review:c7:integration": "pnpm --filter @dsh-work/server test:review:c7:integration",
    "test:review:p2:origin": "pnpm --filter @dsh-work/server test:review:p2:origin",
    "test:review:p2:skill:unit": "pnpm --filter @dsh-work/server test:review:p2:skill:unit",
    "test:review:p2:skill:integration": "pnpm --filter @dsh-work/server test:review:p2:skill:integration",
    "test:review:p2:logging": "pnpm --filter @dsh-work/server test:review:p2:logging",
    "test:review:p2": "pnpm test:review:p2:origin && pnpm test:review:p2:skill:unit && pnpm test:review:p2:skill:integration && pnpm test:review:p2:logging"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.62.1",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.4.0",
    "happy-dom": "^20.11.15",
    "typescript-eslint": "^8.46.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.2.0"
  }
}
