# dsh-work server
# Use 0.0.0.0 when the Dockerized AI Hub must reach this host process through
# host.docker.internal. Use 127.0.0.1 if AI Hub also runs natively on the host.
DSH_WORK_SERVER_HOST=0.0.0.0
DSH_WORK_SERVER_PORT=4190
DSH_WORK_DATABASE_URL=postgres://dsh_work:change-me@127.0.0.1:5432/dsh_work
# Durable application data. Skill folders are stored below
# DSH_WORK_DATA_ROOT/skills and must be backed up with PostgreSQL.
# DSH_WORK_DATA_ROOT=/absolute/path/to/dsh-work-data

# Authentication defaults to prototype outside production. After registering
# dsh-work in AI Hub, change this to oidc and fill the values below.
DSH_WORK_AUTH_MODE=prototype

# AI Hub Platform API (shared by the employee workbench and admin portal).
# AI_HUB_PLATFORM_URL=http://platform.localhost:8088
# AI_HUB_APPLICATION_ID=dsh-work
# AI_HUB_ENVIRONMENT=local
# AI_HUB_OIDC_ISSUER=http://auth.localhost:8088/application/o/ai-hub-dsh-work-local-v1/
# AI_HUB_CLIENT_ID=dsh-work__local__v1
# AI_HUB_CLIENT_SECRET=copy-the-one-time-secret-from-ai-hub
# AI_HUB_OIDC_AUDIENCE=dsh-work__local__v1

# Browser-facing URLs. These two callback URLs must both be registered in the
# same AI Hub application environment (strict match, one URL per line).
# AI_HUB_WORKBENCH_PORTAL_URL=http://localhost:4174
# AI_HUB_WORKBENCH_REDIRECT_URI=http://localhost:4190/auth/workbench/callback
# AI_HUB_ADMIN_PORTAL_URL=http://localhost:4180
# AI_HUB_ADMIN_REDIRECT_URI=http://localhost:4190/auth/admin/callback

# Generate with: openssl rand -base64 48
# DSH_WORK_SESSION_SECRET=replace-with-at-least-32-random-characters
# DSH_WORK_COOKIE_SECURE=false
# DSH_WORK_SESSION_TTL_SECONDS=28800
# DSH_WORK_OIDC_TRANSACTION_TTL_SECONDS=600
# DSH_WORK_OIDC_JWKS_CACHE_TTL_SECONDS=300
# DSH_WORK_OIDC_JWKS_STALE_TTL_SECONDS=3600
# The service reconciles once at startup and then on this interval.
# 0 is allowed only for isolated non-production diagnostics.
# DSH_WORK_DIRECTORY_SYNC_INTERVAL_SECONDS=900

# Local development fallback: a verified DSH source checkout.
# If omitted, dsh-work resolves ../deepseek-harness.
DSH_RUNTIME_HOME=/Users/max/projects/deepseek-harness
# Explicit, development-only compatibility mode for the existing local DSH.
# Production rejects this mode and remains pinned to the primary Runtime Lock.
DSH_RUNTIME_COMPATIBILITY=legacy-0.1.1-rc.2
DSH_EXPECTED_VERSION=0.1.1-rc.2
DSH_EXPECTED_COMMIT=b150a551b8d465e31e418e1b2eaf5e79bbb7d28e

# Reserved dsh-work custom-runtime contract. Upstream DSH does not ship a
# managed-distribution mode or a bin named dsh-acp. Leave these unset until an
# internally packaged and verified runtime entry is implemented.
# DSH_RUNTIME_COMMAND=/absolute/path/to/verified/runtime-entry
# DSH_RUNTIME_ARGS_JSON=[]

# Model secrets are intentionally absent. DSH resolves them from its own
# Credentials Provider / DSH_HOME; never add secret values to this file.

# Skill 安装来源：默认允许 GitHub/API/codeload/raw/release-assets 公共域名。
# 额外域名用逗号分隔，仍拒绝 HTTP、私有/回环地址、凭据与未授权重定向。
# DSH_WORK_SKILL_SOURCE_HOSTS=skills.example.com

# Optional Python Skill sandbox. Leave unset to mark Python-bearing Skill plans
# incompatible. The image must be present locally and pinned by sha256 digest.
# List the exact normalized Python distribution names already baked into it.
# DSH_WORK_PYTHON_IMAGE=registry.example.com/dsh-work/python-skill@sha256:replace-with-64-hex-digest
# DSH_WORK_PYTHON_PACKAGES=pandas,openpyxl

# Fresh install only: enable temporarily for /auth/admin/bootstrap. Normal logins never need this scope.
# Existing installations without a complete claim ledger must keep this false pending explicit reconciliation.
DSH_WORK_ADMIN_BOOTSTRAP_ENABLED=false
