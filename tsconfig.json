{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "apps/admin-web/**/*.ts",
    "apps/admin-web/**/*.vue",
    "apps/workbench-web/**/*.ts",
    "apps/workbench-web/**/*.vue",
    "packages/**/*.ts",
    "packages/**/*.vue",
    "server/src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
