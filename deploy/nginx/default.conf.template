map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

upstream dsh_work_server {
  # Point the host backend at one IPv4 address (production). On Docker Desktop the default name
  # also resolves to an unreachable ULA IPv6 gateway; a connect failure marks the only upstream
  # down for fail_timeout, and concurrent requests then fail with "no live upstreams".
  # max_fails=0 stops that amplification.
  server ${DSH_WORK_UPSTREAM_HOST}:${DSH_WORK_SERVER_PORT} max_fails=0;
  keepalive 32;
}

server {
  listen 8443 ssl default_server;
  listen 8444 ssl default_server;
  server_name _;

  ssl_certificate /etc/dsh-work/tls/server.crt;
  ssl_certificate_key /etc/dsh-work/tls/server.key;

  return 421;
}

server {
  listen 8443 ssl;
  server_name ${DSH_WORK_WORKBENCH_SERVER_NAMES};

  ssl_certificate /etc/dsh-work/tls/server.crt;
  ssl_certificate_key /etc/dsh-work/tls/server.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:DSHWORK:10m;
  ssl_session_timeout 1d;

  # Both portals: no framing by other sites, no MIME sniffing, HTTPS only.
  # HSTS deliberately omits includeSubDomains; browsers ignore it for bare IP hosts.
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Frame-Options "DENY" always;
  add_header Content-Security-Policy "frame-ancestors 'none'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "same-origin" always;

  root /srv/workbench;
  index index.html;
  client_max_body_size 50m;

  location = /health/live {
    proxy_pass http://dsh_work_server;
    include /etc/nginx/proxy_params;
  }

  location = /health {
    proxy_pass http://dsh_work_server;
    include /etc/nginx/proxy_params;
  }

  # Container liveness only: the web healthcheck must not depend on the host server's startup
  # probes (they can legitimately take more than 20 minutes). Deployment readiness is asserted
  # separately by scripts/deploy/release-wait.mjs through the public /health and /health/ready.
  location = /nginx-health {
    access_log off;
    return 200 "ok\n";
  }

  location /api/ {
    proxy_pass http://dsh_work_server;
    include /etc/nginx/proxy_params;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /auth/ {
    proxy_pass http://dsh_work_server;
    include /etc/nginx/proxy_params;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}

