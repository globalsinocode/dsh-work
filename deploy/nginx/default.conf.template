map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# 上游解析参数化（站点取值，不进产品默认行为）：
# Docker Desktop 的 host.docker.internal 同时返回 A(192.168.65.254) 与 AAAA，
# 而容器内该 IPv6 不可达；nginx 在加载配置时会把解析到的每个地址各建成一个 upstream
# server 参与轮询，落到 IPv6 的连接失败，两个 server 同时被 fail_timeout 判死时返回 502。
# 因此改用 Docker 内置 DNS 动态解析并 ipv6=off 只取 A 记录；zone 是使用 resolve 的前提。
# resolver 地址与上游主机名由站点通过 deploy/compose.yaml 的 web.environment 提供，
# 默认值见该文件（host.docker.internal / 127.0.0.11）。
resolver ${DSH_WORK_NGINX_DNS_RESOLVER} valid=10s ipv6=off;

upstream dsh_work_server {
  zone dsh_work_server 64k;
  server ${DSH_WORK_NGINX_UPSTREAM_HOST}:${DSH_WORK_SERVER_PORT} resolve;
  keepalive 32;
}

server {
  listen 8443 ssl default_server;
  listen 8444 ssl default_server;
  server_name _;

  ssl_certificate /etc/dsh-work/tls/server.crt;
  ssl_certificate_key /etc/dsh-work/tls/server.key;

  return 421;
}

server {
  listen 8443 ssl;
  server_name ${DSH_WORK_WORKBENCH_SERVER_NAMES};

  ssl_certificate /etc/dsh-work/tls/server.crt;
  ssl_certificate_key /etc/dsh-work/tls/server.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:DSHWORK:10m;
  ssl_session_timeout 1d;

  root /srv/workbench;
  index index.html;
  client_max_body_size 50m;

  location = /health/live {
    proxy_pass http://dsh_work_server;
    include /etc/nginx/proxy_params;
  }

  location = /health {
    proxy_pass http://dsh_work_server;
    include /etc/nginx/proxy_params;
  }

  location /api/ {
    proxy_pass http://dsh_work_server;
    include /etc/nginx/proxy_params;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /auth/ {
    proxy_pass http://dsh_work_server;
    include /etc/nginx/proxy_params;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}

server {
  listen 8444 ssl;
  server_name ${DSH_WORK_ADMIN_SERVER_NAMES};

  ssl_certificate /etc/dsh-work/tls/server.crt;
  ssl_certificate_key /etc/dsh-work/tls/server.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:DSHWORK:10m;
  ssl_session_timeout 1d;

  root /srv/admin;
  index index.html;
  client_max_body_size 50m;

  location = /health/live {
    proxy_pass http://dsh_work_server;
    include /etc/nginx/proxy_params;
  }

  location = /health {
    proxy_pass http://dsh_work_server;
    include /etc/nginx/proxy_params;
  }

  location /api/ {
    proxy_pass http://dsh_work_server;
    include /etc/nginx/proxy_params;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /auth/ {
    proxy_pass http://dsh_work_server;
    include /etc/nginx/proxy_params;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
