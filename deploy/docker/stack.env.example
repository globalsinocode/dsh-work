# Copy to stack.env and edit before `pnpm docker:up`.
# Model API keys live in DSH credentials (DSH_HOME volume), not here.

NODE_ENV=production

DSH_WORK_POSTGRES_DB=dsh_work
DSH_WORK_POSTGRES_USER=dsh_work
DSH_WORK_POSTGRES_PASSWORD=change-me-long-random-password

DSH_WORK_SERVER_PORT=4190
DSH_WORK_WORKBENCH_HTTPS_PORT=4174
DSH_WORK_ADMIN_HTTPS_PORT=4180

DSH_WORK_SESSION_SECRET=replace-with-at-least-32-random-characters-from-openssl
DSH_WORK_COOKIE_SECURE=true
DSH_WORK_SESSION_TTL_SECONDS=28800

# Required for ACP Agent runs (site gateway / model id).
DSH_WORK_ACP_PROVIDER=replace-me
DSH_WORK_ACP_MODEL=replace-me

# Execution container image (pull once: docker pull …)
DSH_WORK_EXECUTION_IMAGE=ghcr.io/tonycc/dsh-work/execution@sha256:a59f988be919b4332a79d5a4ad92fff3af542e56cbffbb58dc47bf6be195f42c

# Portal origins (must match browser URL and nginx TLS port mapping).
DSH_WORK_WORKBENCH_ORIGINS=https://localhost:4174
DSH_WORK_ADMIN_ORIGINS=https://localhost:4180
DSH_WORK_WORKBENCH_DEFAULT_ORIGIN=https://localhost:4174
DSH_WORK_ADMIN_DEFAULT_ORIGIN=https://localhost:4180
DSH_WORK_PUBLIC_HOST=localhost

DSH_WORK_WORKBENCH_SERVER_NAMES=localhost
DSH_WORK_ADMIN_SERVER_NAMES=localhost
DSH_WORK_HEALTHCHECK_HOST=localhost

# First admin: set true once, open https://localhost:4180/auth/admin/bootstrap , then set false.
DSH_WORK_ADMIN_BOOTSTRAP_ENABLED=true

# Optional MCP Bearer encryption (openssl rand -base64 32)
# DSH_CREDENTIAL_MASTER_KEY=
# DSH_CREDENTIAL_MASTER_KEY_ID=v1

# Lock must match baked harness (see server/config/dsh/runtime-lock.json). Unset in production lock path:
# DSH_RUNTIME_COMPATIBILITY=

# Docker 镜像默认在 compose/Dockerfile 中设置 DSH_RUNTIME_COMMAND + dsh-runtime.json（无 .git 的 harness）。
# 非 compose 部署若拷贝 harness 且无 git，需同样配置或设置 DSH_RUNTIME_COMMAND。
