# Stable deployment paths. Keep the deployment root under /Users so Docker
# Desktop can bind-mount the active frontend release.
DSH_WORK_DEPLOY_ROOT=/Users/deploy/services/dsh-work
DSH_WORK_GITHUB_REPOSITORY=tonycc/dsh-work
DSH_WORK_NODE_BIN=/opt/homebrew/bin/node
# launchd does not inherit an interactive shell PATH. Keep every deployment
# dependency on an explicit, operator-controlled search path.
PATH=/opt/homebrew/bin:/usr/local/bin:/Applications/Docker.app/Contents/Resources/bin:/usr/bin:/bin:/usr/sbin:/sbin

# The repository is public. A narrow launchd watcher polls only immutable,
# attested stable Releases; it is not a GitHub Actions self-hosted runner.
DSH_WORK_AUTO_DEPLOY_ENABLED=false
DSH_WORK_RELEASE_POLL_INTERVAL_SECONDS=300

# Native dsh-work server and Docker-hosted PostgreSQL.
NODE_ENV=production
DSH_WORK_SERVER_HOST=127.0.0.1
DSH_WORK_SERVER_PORT=4190
# New multi-address contract. Keep the legacy single value equal to the first
# item during the compatibility window.
DSH_WORK_BIND_ADDRESSES=192.168.33.20
DSH_WORK_BIND_ADDRESS=192.168.33.20
DSH_WORK_WORKBENCH_PORT=4174
DSH_WORK_ADMIN_PORT=4180
DSH_WORK_POSTGRES_PORT=5434
DSH_WORK_POSTGRES_DB=dsh_work
DSH_WORK_POSTGRES_USER=dsh_work
DSH_WORK_POSTGRES_PASSWORD=replace-me-with-a-long-random-password
DSH_WORK_DATABASE_URL=postgres://dsh_work:replace-me-with-url-encoded-password@127.0.0.1:5434/dsh_work
DSH_WORK_DATA_ROOT=/Users/deploy/services/dsh-work/data
DSH_WORK_DSH_SESSIONS_ROOT=/Users/deploy/services/dsh-work/data/dsh-sessions
# Must be a mounted NAS or other remote backup filesystem, and must resolve to
# a device distinct from the deployment root. A local folder is not off-host.
# Every upgrade backup is copied and verified here before migration.
DSH_WORK_OFF_HOST_BACKUP_DIRECTORY=/Volumes/dsh-work-backups

# DSH is installed and built on the Mac mini host. Leave DSH_RUNTIME_COMMAND
# unset for the verified source-checkout mode used by the current locked DSH.
DSH_RUNTIME_HOME=/Users/deploy/services/deepseek-harness
DSH_EXPECTED_VERSION=0.1.2-rc.1
DSH_EXPECTED_COMMIT=76fda729799fe9b3848dbe2c211d4b231032b81e
# Development-only compatibility modes are forbidden in production. Keep
# DSH_RUNTIME_COMPATIBILITY unset.
DSH_HOME=/Users/deploy/.dsh

# Python Skill execution stays disabled unless an approved, locally available
# image is pinned by digest. Names must match packages already baked into it;
# the service never installs dependencies at runtime.
# DSH_WORK_PYTHON_IMAGE=registry.example.com/dsh-work/python-skill@sha256:replace-with-64-hex-digest
# DSH_WORK_PYTHON_PACKAGES=pandas,openpyxl

# HTTPS is mandatory when NODE_ENV=production. The certificate must include
# the Mac mini private IP in subjectAltName and be trusted by employee devices.
DSH_WORK_PUBLIC_HOST=192.168.33.20
DSH_WORK_TLS_CERT_FILE=/Users/deploy/services/dsh-work/certs/server.crt
DSH_WORK_TLS_KEY_FILE=/Users/deploy/services/dsh-work/certs/server.key
DSH_WORK_CA_CERT_FILE=/Users/deploy/services/dsh-work/certs/root-ca.crt
NODE_EXTRA_CA_CERTS=/Users/deploy/services/dsh-work/certs/root-ca.crt

# AI Hub OIDC identity. Both frontends use one AI Hub application credential.
DSH_WORK_AUTH_MODE=oidc
DSH_WORK_SESSION_SECRET=replace-me-with-at-least-32-random-characters
DSH_WORK_COOKIE_SECURE=true
DSH_WORK_SESSION_TTL_SECONDS=28800
DSH_WORK_DIRECTORY_SYNC_INTERVAL_SECONDS=900
AI_HUB_PLATFORM_URL=https://192.168.33.20
AI_HUB_APPLICATION_ID=dsh-work
AI_HUB_ENVIRONMENT=production
AI_HUB_OIDC_ISSUER=replace-me-with-ai-hub-issuer
AI_HUB_OIDC_AUDIENCE=replace-me-with-ai-hub-audience
AI_HUB_CLIENT_ID=replace-me-with-ai-hub-client-id
AI_HUB_CLIENT_SECRET=replace-me-with-ai-hub-client-secret
AI_HUB_WORKBENCH_PORTAL_URL=https://192.168.33.20:4174
AI_HUB_WORKBENCH_REDIRECT_URI=https://192.168.33.20:4174/auth/workbench/callback
AI_HUB_ADMIN_PORTAL_URL=https://192.168.33.20:4180
AI_HUB_ADMIN_REDIRECT_URI=https://192.168.33.20:4180/auth/admin/callback
# Add every approved IP/domain Origin here. The default is used only when the
# application must generate a canonical link; every listed Origin is supported.
DSH_WORK_WORKBENCH_ORIGINS=https://192.168.33.20:4174
DSH_WORK_ADMIN_ORIGINS=https://192.168.33.20:4180
DSH_WORK_WORKBENCH_DEFAULT_ORIGIN=https://192.168.33.20:4174
DSH_WORK_ADMIN_DEFAULT_ORIGIN=https://192.168.33.20:4180

# Optional image overrides. Defaults are immutable, pinned images.
# DSH_WORK_POSTGRES_IMAGE=postgres:17.11-alpine@sha256:18cfe3ef5e6815560c98237d6216d1e5119702fb0f3894c8785dd58b8bbe5d73
# DSH_WORK_NGINX_IMAGE=nginx:1.30.4-alpine@sha256:97d490c12ba55b4946b01546d1c3ed324e8d41ab1c9fcb2a616aa470620e5b46
